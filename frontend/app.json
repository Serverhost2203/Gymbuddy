{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0C0E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.fitjourneyapp.hny3xq",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan food barcodes and take progress photos",
        "NSPhotoLibraryUsageDescription": "Add progress photos from your library"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.fitjourneyapp.hny3xq",
      "permissions": ["android.permission.CAMERA", "android.permission.READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-localization",
      [
        "expo-camera",
        { "cameraPermission": "Scan food barcodes and take progress photos" }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Add progress photos from your library" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
